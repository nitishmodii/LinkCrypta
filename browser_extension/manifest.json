{
  "manifest_version": 3,
  "name": "LinkCrypta Password Manager",
  "version": "1.0.0",
  "description": "Secure password manager with auto-fill capabilities - seamlessly sync with LinkCrypta app",
  
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "contextMenus",
    "notifications",
    "identity"
  ],
  
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "https://www.googleapis.com/*",
    "https://securetoken.googleapis.com/*",
    "https://identitytoolkit.googleapis.com/*",
    "https://firestore.googleapis.com/*",
    "https://accounts.google.com/*",
    "https://oauth2.googleapis.com/*"
  ],
  
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  
  "oauth2": {
    "client_id": "795878816417-a5jab510h6c0nolcpcsvumt3nljao4bb.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/userinfo.email",
      "https://www.googleapis.com/auth/userinfo.profile"
    ]
  },
  
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "src/shared/config.js",
        "src/shared/crypto.js",
        "src/shared/firebase-config.js",
        "src/content/form-detector.js",
        "src/content/auto-capture.js",
        "src/content/auto-fill.js",
        "src/content/content-script.js"
      ],
      "css": ["src/content/content-styles.css"],
      "run_at": "document_end"
    }
  ],
  
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "LinkCrypta",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  
  "web_accessible_resources": [
    {
      "resources": [
        "src/content/injected-script.js",
        "icons/*",
        "view_passwords.html"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  
  "commands": {
    "open-quick-search": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Open LinkCrypta quick search"
    },
    "auto-fill-password": {
      "suggested_key": {
        "default": "Ctrl+Shift+F",
        "mac": "Command+Shift+F"
      },
      "description": "Auto-fill password on current page"
    }
  },
  
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
